--- /dev/null
+++ b/app/services/cyberllm_rules.py
@@ -0,0 +1,80 @@
+"""Deterministic detection layer for CyberLLM analysis.
+
+CyberLLM's product vision puts deterministic detection BEFORE LLM reasoning,
+and pilot v8 has a demonstrated blind spot: it called an SSRF request to the
+cloud metadata endpoint likely_benign with high confidence (frozen T1 item
+22). These rules are narrow and evidence-based: every firing cites the exact
+substring it matched. A rule never invents attribution or a technique ID.
+
+- metadata_endpoint: fetch of a cloud metadata service (169.254.169.254,
+  metadata.google.internal) as a URL target. High severity.
+- private_fetch_target: loopback/private address as a fetch target. High.
+- credential_file_probe: requests for .env, .git/config, credentials files. High.
+- repeated_probe: >= 4 distinct sensitive paths in one submission. Medium.
+"""
+
+from __future__ import annotations
+
+import re
+from urllib.parse import unquote, urlparse
+
+_METADATA_HOSTS = {"169.254.169.254", "metadata.google.internal", "metadata.google"}
+_PRIVATE_PREFIXES = ("10.", "172.16.", "172.17.", "172.18.", "172.19.", "172.2",
+                     "172.30.", "172.31.", "192.168.", "127.")
+_CREDENTIAL_PATHS = ("/.env", "/.git/config", "/.aws/credentials", "/id_rsa",
+                     "/wp-config.php", "/config.php", "/.htpasswd", "/.svn/entries")
+_SUSPICIOUS_PATHS = ("/.env", "/.git/", "/wp-login.php", "/.aws/", "/admin",
+                     "/phpmyadmin", "/.svn/", "/backup", "/config")
+
+
+def _urls_in(text: str) -> list[str]:
+    return [unquote(u).rstrip(".,);") for u in re.findall(r"https?://[^\s'\"<>]+", text)]
+
+
+def _is_private_or_loopback(host: str) -> bool:
+    host = host.lower().split(":")[0]
+    return host in ("localhost",) or host.startswith(_PRIVATE_PREFIXES) or host == "0.0.0.0"
+
+
+def screen(text: str) -> list[dict]:
+    findings: list[dict] = []
+    lowered = text.lower()
+    for url in _urls_in(text):
+        host = (urlparse(url).hostname or "").lower()
+        if host in _METADATA_HOSTS:
+            findings.append({
+                "rule": "metadata_endpoint", "severity": "high", "evidence": url,
+                "explanation": (
+                    "Request targets a cloud instance-metadata service. "
+                    "This is a server-side request forgery (SSRF) pattern: "
+                    "metadata endpoints can disclose instance credentials. "
+                    "Treat as a threat regardless of benign-looking context."
+                ),
+            })
+        elif _is_private_or_loopback(host):
+            findings.append({
+                "rule": "private_fetch_target", "severity": "high", "evidence": url,
+                "explanation": "Request asks the server to fetch a loopback or private network address, a standard SSRF indicator.",
+            })
+    for path in _CREDENTIAL_PATHS:
+        if path in lowered:
+            findings.append({
+                "rule": "credential_file_probe", "severity": "high", "evidence": path,
+                "explanation": "Request probes for a credential or configuration file.",
+            })
+    distinct = {p for p in _SUSPICIOUS_PATHS if p in lowered}
+    if len(distinct) >= 4:
+        findings.append({
+            "rule": "repeated_probe", "severity": "medium",
+            "evidence": ", ".join(sorted(distinct)),
+            "explanation": "Multiple distinct sensitive paths probed in one submission, consistent with automated scanning.",
+        })
+    return findings
+
+
+def suggested_classification(findings: list[dict]) -> str:
+    if any(f["severity"] == "high" for f in findings):
+        return "likely_threat"
+    if findings:
+        return "needs_review"
+    return "likely_benign"
diff --git a/app/services/cyberllm_schema.py b/app/services/cyberllm_schema.py
new file mode 100644
index 0000000..30214fb
--- /dev/null
+++ b/app/services/cyberllm_schema.py
@@ -0,0 +1,64 @@
+"""Schema validation for CyberLLM output.
+
+The response schema deliberately has NO MITRE ATT&CK field. Exact technique-ID
+prediction measures 0.000-0.025 across all pilots; presenting a guessed ID as
+a finding would launder a guess into a fact. If MITRE attribution is ever
+added, it must be labeled unverified/candidate, never confirmed.
+
+Parsing rules:
+- Extract the first {...} JSON object (the model sometimes wraps it in
+  prose or code fences).
+- Require classification in the allowed set, confidence in the allowed set,
+  and a non-empty summary. Other fields default to empty when absent but
+  must be the right types when present. Unknown keys are DROPPED.
+- Anything that fails -> parse_ok False. Callers degrade to needs_review
+  with confidence low and the raw text preserved verbatim for a human.
+  A half-written JSON object is not evidence; never salvage-guess fields.
+"""
+
+from __future__ import annotations
+
+import json
+import re
+
+_ALLOWED_CLASS = {"likely_benign", "needs_review", "likely_threat"}
+_ALLOWED_CONF = {"low", "medium", "high"}
+
+
+def extract_json(raw: str) -> tuple[dict | None, bool]:
+    text = raw.strip()
+    text = re.sub(r"^```(?:json)?\s*", "", text)
+    text = re.sub(r"\s*```$", "", text)
+    start = text.find("{")
+    if start < 0:
+        return None, False
+    try:
+        obj = json.loads(text[start:])
+        return (obj, True) if isinstance(obj, dict) else (None, False)
+    except json.JSONDecodeError:
+        return None, False
+
+
+def validate(obj: dict) -> tuple[dict | None, bool]:
+    cls, conf, summary = obj.get("classification"), obj.get("confidence"), obj.get("summary")
+    if cls not in _ALLOWED_CLASS or conf not in _ALLOWED_CONF:
+        return None, False
+    if not isinstance(summary, str) or not summary.strip():
+        return None, False
+    cleaned = {
+        "classification": cls,
+        "confidence": conf,
+        "summary": summary.strip(),
+        "indicators": [str(x) for x in obj["indicators"]] if isinstance(obj.get("indicators"), list) else [],
+        "reasoning": obj["reasoning"] if isinstance(obj.get("reasoning"), str) else "",
+        "limitations": [str(x) for x in obj["limitations"]] if isinstance(obj.get("limitations"), list) else [],
+        "recommended_actions": [str(x) for x in obj["recommended_actions"]] if isinstance(obj.get("recommended_actions"), list) else [],
+    }
+    return cleaned, True
+
+
+def parse_model_output(raw: str) -> tuple[dict | None, bool]:
+    obj, ok = extract_json(raw)
+    if not ok:
+        return None, False
+    return validate(obj)
