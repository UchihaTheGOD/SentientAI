+"""CyberLLM inference — greedy generation with the trained prompts, verbatim.
+
+Pilot v8 is prompt-sensitive: paraphrased prompts route it to prose answers
+(pilot v4 lesson), so the templates below are copied exactly from the frozen
+evaluation harness that produced pilots v2-v8. Do not reword them.
+
+Budgets match frozen eval v2.1: 320 tokens for log/HTTP/URL, 512 for
+vulnerability descriptions. A generation that hits its budget is reported
+as truncated; truncation is a signal for the schema layer, not something
+to hide.
+"""
+
+from __future__ import annotations
+
+import threading
+import time
+from typing import Any
+
+from .cyberllm_loader import ensure_loaded, get_bundle
+
+SYSTEM_PROMPT = (
+    "You are Cyber LLM, a cybersecurity-focused AI assistant created by Gaurav Bisht. "
+    "Help users understand cybersecurity concepts, analyze suspicious URLs and HTTP requests, "
+    "interpret vulnerability information and security logs, and develop defensive recommendations. "
+    "Be accurate and transparent about uncertainty. Do not invent evidence, credentials, "
+    "affiliations, or capabilities. Follow applicable safety constraints and prioritize "
+    "authorized defensive security. When asked who you are, identify yourself as Cyber LLM. "
+    "When asked who created you, answer that you were created by Gaurav Bisht."
+)
+
+CLS_TMPL = (
+    "Analyze this {kind} and respond with a JSON object with keys summary, "
+    "classification (likely_benign, needs_review, or likely_threat), "
+    "confidence (low, medium, or high), indicators, reasoning, "
+    "limitations, recommended_actions.\n{kind}: {text}\nJSON:"
+)
+
+LOG_TMPL = (
+    "Analyze this security log and respond with a JSON object with keys summary, "
+    "classification (likely_benign, needs_review, or likely_threat), "
+    "confidence (low, medium, or high), indicators, reasoning, "
+    "limitations, recommended_actions.\nLog:\n{text}\nJSON:"
+)
+
+BUDGETS = {"log": 320, "http_request": 320, "url": 320, "vulnerability": 512}
+KIND_LABELS = {"http_request": "HTTP request", "url": "URL", "vulnerability": "vulnerability description"}
+
+_sem = threading.Semaphore(2)
+
+
+class ModelUnavailable(RuntimeError):
+    pass
+
+
+def build_user_prompt(kind: str, text: str) -> str:
+    if kind == "log":
+        return LOG_TMPL.format(text=text)
+    return CLS_TMPL.format(kind=KIND_LABELS[kind], text=text)
+
+
+def generate(kind: str, text: str, max_new_tokens: int | None = None) -> dict[str, Any]:
+    """Run one greedy generation. Raises ModelUnavailable when not loaded."""
+    status = ensure_loaded()
+    if not status.ready:
+        raise ModelUnavailable(status.reason or "model not loaded")
+    import torch
+
+    bundle = get_bundle()
+    tok, model = bundle["tok"], bundle["model"]
+    max_new = max_new_tokens or BUDGETS[kind]
+    messages = [
+        {"role": "system", "content": SYSTEM_PROMPT},
+        {"role": "user", "content": build_user_prompt(kind, text)},
+    ]
+    # transformers 5.x: apply_chat_template(return_tensors="pt") returns a
+    # BatchEncoding; extract input_ids explicitly.
+    # enable_thinking=False is REQUIRED: Qwen3's default template otherwise
+    # emits a <think> reasoning trace that consumes the whole token budget
+    # before any JSON appears (this exact failure was reproduced live and
+    # fixed by matching the frozen eval harness, which passes
+    # enable_thinking=False).
+    try:
+        enc = tok.apply_chat_template(messages, tokenize=True, add_generation_prompt=True,
+                                      return_tensors="pt", enable_thinking=False)
+    except TypeError:
+        enc = tok.apply_chat_template(messages, tokenize=True, add_generation_prompt=True,
+                                      return_tensors="pt")
+    input_ids = enc["input_ids"] if hasattr(enc, "__getitem__") else enc.input_ids
+    t0 = time.perf_counter()
+    with _sem:
+        with torch.no_grad():
+            out = model.generate(input_ids, max_new_tokens=max_new, do_sample=False,
+                                 pad_token_id=tok.pad_token_id)
+    latency_ms = int((time.perf_counter() - t0) * 1000)
+    new_tokens = out[0][input_ids.shape[1]:]
+    raw = tok.decode(new_tokens, skip_special_tokens=True)
+    return {
+        "raw": raw,
+        "output_tokens": int(new_tokens.shape[0]),
+        "truncated": int(new_tokens.shape[0]) >= max_new,
+        "latency_ms": latency_ms,
+    }
diff --git a/app/services/cyberllm_loader.py b/app/services/cyberllm_loader.py
new file mode 100644
index 0000000..0e4d0ef
--- /dev/null
+++ b/app/services/cyberllm_loader.py
@@ -0,0 +1,204 @@
+"""CyberLLM loader — Qwen3 base + fine-tuned LoRA adapter, GPU or CPU inference.
+
+Mirrors the Sentinel loader's conventions: lazy loading (nothing loads at
+import time), a status dataclass, torch-optional import guard so the app
+stays fail-open when torch is absent, and RSS reporting via psutil.
+
+Checkpoint selection (never overwritten; all paths are read-only here):
+- Leading candidate: pilot v8 — Qwen3-1.7B (data-v3.2), adapter sha256
+  d624ed79...5a5b1. Verified load + correct probes from the persisted
+  bundle copy (Kaggle recovery kernel cyberllm-recovery-v8 v2).
+- Fallback: pilot v3 — Qwen3-0.6B (data-v2), adapter sha256 384d296a...8967,
+  the overall reference checkpoint. Select it with
+  CYBERLLM_ADAPTER_DIR pointing at the v3 adapter and CYBERLLM_BASE_MODEL
+  Qwen/Qwen3-0.6B (revision c1899de...).
+
+Paths come from the environment so deployments can point at a local copy
+without editing code:
+  CYBERLLM_BASE_DIR    local base-model directory (preferred when it exists)
+  CYBERLLM_BASE_MODEL  HF id (default Qwen/Qwen3-1.7B)
+  CYBERLLM_BASE_REVISION  pinned revision (default 70d244cc...)
+  CYBERLLM_ADAPTER_DIR adapter directory (default local_models/cyberllm/v8)
+  CYBERLLM_DEVICE      auto (default), cpu, or cuda. auto uses CUDA when
+                       torch reports it, else CPU.
+  CYBERLLM_LOAD_IN_8BIT  1 = 8-bit quantized load on CUDA (bitsandbytes),
+                       a fallback for tight VRAM. 0 (default) = plain
+                       float16-on-CUDA / bfloat16-on-CPU load.
+
+Device notes: on CUDA the model loads in float16, not bfloat16 — Turing
+cards such as the GTX 1660 have no bfloat16 tensor-core support, while
+float16 works. Weights are ~3.4 GB in float16; with CUDA context, KV
+cache and activations a 6 GB card is workable but tight, so a CUDA
+out-of-memory failure is recorded in the status and the API returns 503
+with the reason instead of a fabricated verdict — then retry with
+CYBERLLM_LOAD_IN_8BIT=1 or CYBERLLM_DEVICE=cpu.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import logging
+import os
+import threading
+import time
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Any, Optional
+
+logger = logging.getLogger("sentientai.cyberllm")
+
+BASE_DIR = Path(__file__).resolve().parent.parent.parent
+
+BASE_MODEL_ID = os.getenv("CYBERLLM_BASE_MODEL", "Qwen/Qwen3-1.7B")
+BASE_REVISION = os.getenv(
+    "CYBERLLM_BASE_REVISION", "70d244cc86ccca08cf5af4e1e306ecf908b1ad5e"
+)
+BASE_DIR_ENV = os.getenv("CYBERLLM_BASE_DIR", "")
+ADAPTER_DIR = Path(
+    os.getenv("CYBERLLM_ADAPTER_DIR", BASE_DIR / "local_models" / "cyberllm" / "v8")
+)
+# sha256 of adapter_model.safetensors for the default (pilot v8) adapter.
+# When CYBERLLM_ADAPTER_DIR points elsewhere, set CYBERLLM_ADAPTER_SHA256
+# to that adapter's verified hash; empty means "do not verify".
+ADAPTER_SHA256 = os.getenv(
+    "CYBERLLM_ADAPTER_SHA256",
+    "d624ed793a45a64cb541577441c87c7d2feb83c37a84da057d1c15e58e45a5b1",
+)
+DEVICE_ENV = os.getenv("CYBERLLM_DEVICE", "auto").strip().lower()
+LOAD_IN_8BIT = os.getenv("CYBERLLM_LOAD_IN_8BIT", "0").strip() == "1"
+
+try:
+    import torch  # type: ignore
+
+    _TORCH_AVAILABLE = True
+except ImportError:
+    torch = None  # type: ignore
+    _TORCH_AVAILABLE = False
+
+
+@dataclass
+class CyberLLMStatus:
+    ready: bool = False
+    state: str = "not_loaded"
+    reason: Optional[str] = None
+    base_model: str = BASE_MODEL_ID
+    adapter_dir: str = str(ADAPTER_DIR)
+    adapter_sha256: str = ADAPTER_SHA256
+    device: str = "cpu"
+    quantization: str = "none"
+    load_ms: Optional[int] = None
+    rss_mb: Optional[float] = None
+
+
+_status = CyberLLMStatus(reason="not_initialized")
+_bundle: dict[str, Any] = {}
+_lock = threading.Lock()
+
+
+def _get_rss_mb() -> Optional[float]:
+    try:
+        import psutil
+
+        return round(psutil.Process(os.getpid()).memory_info().rss / 1024 / 1024, 1)
+    except Exception:
+        return None
+
+
+def _adapter_sha_ok() -> bool:
+    if not ADAPTER_SHA256:
+        return True
+    f = ADAPTER_DIR / "adapter_model.safetensors"
+    if not f.exists():
+        return False
+    h = hashlib.sha256()
+    with open(f, "rb") as fh:
+        for chunk in iter(lambda: fh.read(1 << 20), b""):
+            h.update(chunk)
+    return h.hexdigest() == ADAPTER_SHA256
+
+
+def get_status() -> CyberLLMStatus:
+    _status.rss_mb = _get_rss_mb()
+    return _status
+
+
+def ensure_loaded() -> CyberLLMStatus:
+    """Load base + adapter once. Records failure instead of raising, so the
+    API can report 503 with the real reason."""
+    global _bundle
+    with _lock:
+        if _status.ready:
+            return _status
+        t0 = time.perf_counter()
+        try:
+            if not _TORCH_AVAILABLE:
+                raise RuntimeError("torch is not installed; CyberLLM cannot load")
+            if not _adapter_sha_ok():
+                raise RuntimeError(
+                    f"adapter hash mismatch or missing file in {ADAPTER_DIR}; "
+                    "refusing to load an unverified checkpoint"
+                )
+            from peft import PeftModel
+            from transformers import AutoModelForCausalLM, AutoTokenizer
+
+            base_path = BASE_DIR_ENV if BASE_DIR_ENV and Path(BASE_DIR_ENV).exists() else BASE_MODEL_ID
+            kwargs: dict[str, Any] = {}
+            if not (BASE_DIR_ENV and Path(BASE_DIR_ENV).exists()):
+                kwargs["revision"] = BASE_REVISION
+            # Report the base that was actually used, not the default id.
+            _status.base_model = f"{base_path}@{BASE_REVISION[:12]}" if not (BASE_DIR_ENV and Path(BASE_DIR_ENV).exists()) else base_path
+            if DEVICE_ENV == "cuda":
+                if not torch.cuda.is_available():
+                    raise RuntimeError(
+                        "CYBERLLM_DEVICE=cuda but torch reports no CUDA GPU; "
+                        "use CYBERLLM_DEVICE=cpu or install a CUDA torch build"
+                    )
+                device = "cuda"
+            elif DEVICE_ENV == "cpu":
+                device = "cpu"
+            elif DEVICE_ENV == "auto":
+                device = "cuda" if torch.cuda.is_available() else "cpu"
+            else:
+                raise RuntimeError(
+                    f"unknown CYBERLLM_DEVICE={DEVICE_ENV!r}; use auto, cpu, or cuda"
+                )
+            dtype = torch.float16 if device == "cuda" else torch.bfloat16
+            load_kwargs: dict[str, Any] = {
+                "dtype": dtype,
+                "low_cpu_mem_usage": True,
+                "attn_implementation": "eager",
+            }
+            if device == "cuda" and LOAD_IN_8BIT:
+                # bitsandbytes 8-bit fallback for tight VRAM (e.g. 6 GB).
+                # transformers imports bitsandbytes itself; a missing install
+                # surfaces here as a load failure with the real reason.
+                load_kwargs["load_in_8bit"] = True
+                load_kwargs["device_map"] = "auto"
+                _status.quantization = "8bit"
+            else:
+                load_kwargs["device_map"] = device
+            base = AutoModelForCausalLM.from_pretrained(
+                base_path, **load_kwargs, **kwargs,
+            )
+            model = PeftModel.from_pretrained(base, str(ADAPTER_DIR))
+            model.eval()
+            tok = AutoTokenizer.from_pretrained(str(ADAPTER_DIR))
+            if tok.pad_token is None:
+                tok.pad_token = tok.eos_token
+            _bundle = {"model": model, "tok": tok, "device": device}
+            _status.ready = True
+            _status.state = "loaded"
+            _status.reason = None
+            _status.device = device
+            _status.load_ms = int((time.perf_counter() - t0) * 1000)
+        except Exception as exc:
+            _status.ready = False
+            _status.state = "failed"
+            _status.reason = f"{type(exc).__name__}: {exc}"
+            logger.warning("cyberllm load failed: %s", exc)
+        _status.rss_mb = _get_rss_mb()
+        return _status
+
+
+def get_bundle() -> dict[str, Any]:
+    return _bundle
