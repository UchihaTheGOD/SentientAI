# SentientAI — environment configuration
# Copy this file to .env and fill in real values. NEVER commit .env.
# This file contains NO real secrets.

# Signing key for sessions and tokens. REQUIRED in production — the app refuses
# to start without it (it will not silently generate one). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# development | production
ENVIRONMENT=development

# SQLite for local development; swap the URL for PostgreSQL in production.
#   sqlite:///./app.db
#   postgresql://user:password@localhost:5432/sentientai
DATABASE_URL=sqlite:///./app.db

# Access-token lifetime, in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Password-reset email (SMTP) ---------------------------------------------
# Provider-agnostic. Leave SMTP_HOST blank in development to log the reset link
# to the console instead of sending mail. Never commit real credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# --- CyberLLM (pilot v8: Qwen3-1.7B + data-v3.2 LoRA adapter) --------------
# `app/config.py` loads `.env` at startup (before any router import), so
# these reach the loader without PowerShell `$env:` lines. A variable
# already set in the shell takes precedence over `.env`.
# PORTABLE DEFAULT — no path is set here on purpose. The loader uses
# <project>/cyberLLMv1/{base,adapter,manifest.json} by default, derived
# from the project root, not from the shell's cwd or any personal folder.
# See cyberLLMv1/README.md for the layout and download commands.
# Optional overrides (only if you must point elsewhere):
#   CYBERLLM_MODEL_ROOT=<project-relative or absolute model root>
#   CYBERLLM_BASE_DIR=<absolute or project-relative base-model directory>
#   CYBERLLM_ADAPTER_DIR=<absolute or project-relative adapter directory>
# Legacy local_models/cyberllm/v8 is used only as an adapter fallback when
# cyberLLMv1/adapter is absent.
CYBERLLM_BASE_MODEL=Qwen/Qwen3-1.7B
CYBERLLM_BASE_REVISION=70d244cc86ccca08cf5af4e1e306ecf908b1ad5e
CYBERLLM_ADAPTER_SHA256=d624ed793a45a64cb541577441c87c7d2feb83c37a84da057d1c15e58e45a5b1
# auto = CUDA when torch reports it, else CPU. Set to cpu to force CPU.
CYBERLLM_DEVICE=auto
# 8-bit CUDA fallback for tight VRAM (needs bitsandbytes; untested on
# Windows — if it fails, delete this line and use CYBERLLM_DEVICE=cpu).
# CYBERLLM_LOAD_IN_8BIT=1
