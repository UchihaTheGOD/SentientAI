# SentientAI Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# Secret key for JWT signing — generate a strong random string
SECRET_KEY=change-me-to-a-random-secret-key

# Database URL — SQLite for development, swap to PostgreSQL for production
# SQLite:      sqlite:///./data/sentientai.db
# PostgreSQL:  postgresql://user:password@localhost:5432/sentientai
DATABASE_URL=sqlite:///./data/sentientai.db

# CyberLLM / Sentinel integration (leave blank to use mock)
CYBERLLM_API_URL=
CYBERLLM_API_KEY=

# Sentinel model version
SENTINEL_MODEL_NAME=SentinelSmolLM2-360M-V9

# Teacher API (external reviewer model, optional)
TEACHER_API_KEY=
TEACHER_BASE_URL=
TEACHER_MODEL=

# Environment: development / production
ENVIRONMENT=development
