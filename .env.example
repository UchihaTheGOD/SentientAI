# SentientAI — environment configuration
# Copy this file to .env and fill in real values. NEVER commit .env.
# This file contains NO real secrets.

# Signing key for sessions and tokens. REQUIRED in production — the app refuses
# to start without it (it will not silently generate one). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# development | production
ENVIRONMENT=development

# SQLite for local development; swap the URL for PostgreSQL in production.
#   sqlite:///./app.db
#   postgresql://user:password@localhost:5432/sentientai
DATABASE_URL=sqlite:///./app.db

# Access-token lifetime, in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Password-reset email (SMTP) ---------------------------------------------
# Provider-agnostic. Leave SMTP_HOST blank in development to log the reset link
# to the console instead of sending mail. Never commit real credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
